<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.Group?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="root"
            fx:controller="de.levingamer8.modlauncher.ui.Controller"
            styleClass="root">

    <!-- TOP BAR: clean, minimal -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
            <!-- Left: Title -->
            <VBox spacing="1">
                <Label text="%app.title" styleClass="h1"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="%app.madeBy" styleClass="mutedSmall"/>
                    <Label fx:id="versionLabel" styleClass="version"/>
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Center: Status + Progress -->
            <VBox alignment="CENTER" spacing="4">
                <HBox spacing="8" alignment="CENTER">
                    <Label fx:id="globalPlaytimeLabel" text="%playtime.totalDefault" styleClass="mutedSmall"/>
                    <Label fx:id="statusLabel" text="%status.ready" styleClass="pillOk"/>
                </HBox>
                <ProgressBar fx:id="progressBar" visible="false" progress="-1" styleClass="progressSlim" prefWidth="200"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right: Menu + Account -->
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <!-- Compact menu for actions -->
                <MenuButton fx:id="menuButton" styleClass="ghost topbarBtn">
                    <graphic>
                        <SVGPath content="M3 6h18 M3 12h18 M3 18h18"
                                 style="-fx-stroke: #eef7ff; -fx-stroke-width: 2; -fx-fill: transparent; -fx-stroke-line-cap: round;"/>
                    </graphic>
                    <items>
                        <MenuItem text="%btn.launcherUpdate" onAction="#onLauncherUpdate"/>
                        <MenuItem text="%btn.openMainFolder" onAction="#onOpenMainFolder"/>
                        <MenuItem text="%btn.hostMode" onAction="#onHostMode"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="%btn.settings" onAction="#onOpenSettings"/>
                    </items>
                </MenuButton>

                <!-- Account -->
                <HBox spacing="6" alignment="CENTER_RIGHT" styleClass="card accountCard">
                    <ImageView fx:id="skinView" fitWidth="28" fitHeight="28" preserveRatio="true" smooth="true"/>
                    <VBox spacing="1">
                        <Label fx:id="accountNameLabel" text="" styleClass="sectionTitle"/>
                        <Label fx:id="loginStatusLabel" text="%account.notLoggedIn" styleClass="mutedSmall"/>
                    </VBox>
                    <Button fx:id="loginButton"
                            text="%btn.loginMicrosoft"
                            onAction="#onAccountButton"
                            styleClass="secondary topbarBtn"/>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <SplitPane fx:id="mainSplit" orientation="VERTICAL" dividerPositions="0.88" styleClass="mainSplit">
            <items>

                <!-- TOP AREA -->
                <HBox spacing="16" styleClass="contentRoot">

                    <!-- INSTANCE AREA (center focus) -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">

                        <!-- Instance control: compact -->
                        <VBox styleClass="card" spacing="10">
                            <!-- Header row: title + icons -->
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="%section.instance" styleClass="sectionTitle"/>
                                <Region HBox.hgrow="ALWAYS"/>

                                <Button onAction="#onNewProfile" styleClass="iconBtn">
                                    <graphic>
                                        <SVGPath content="M12 5v14 M5 12h14"
                                                 style="-fx-stroke: #00ffff; -fx-stroke-width: 2.4; -fx-fill: transparent; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                    </graphic>
                                </Button>

                                <Button onAction="#onEditProfile" styleClass="iconBtn">
                                    <graphic>
                                        <SVGPath content="M5 19l3.5-1 9-9-2.5-2.5-9 9L5 19z M13 6l2.5 2.5"
                                                 style="-fx-stroke: #00ffff; -fx-stroke-width: 2.4; -fx-fill: transparent; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                    </graphic>
                                </Button>

                                <Button onAction="#onDuplicateProfile" styleClass="iconBtn">
                                    <graphic>
                                        <SVGPath content="M8 8h10v10H8z M6 16H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                                                 style="-fx-stroke: #00ffff; -fx-stroke-width: 2.4; -fx-fill: transparent; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                                    </graphic>
                                </Button>

                                <Button onAction="#onDeleteProfile" styleClass="iconBtn iconBtnDanger">
                                    <graphic>
                                        <Group>
                                            <SVGPath content="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"
                                                     styleClass="iconDelete"
                                                     scaleX="0.04"
                                                     scaleY="0.04"/>
                                        </Group>
                                    </graphic>
                                </Button>
                            </HBox>

                            <!-- Selector + Playtime in one row -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <ComboBox fx:id="profileCombo" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                                <Label fx:id="instancePlaytimeLabel" text="%playtime.instanceDefault" styleClass="mutedSmall"/>
                            </HBox>

                            <!-- Actions row -->
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="updateButton"
                                        text="%btn.modpackUpdate"
                                        onAction="#onUpdate"
                                        styleClass="secondary"/>
                                <Button fx:id="openFolderButton"
                                        text="%btn.instanceFolder"
                                        onAction="#onOpenFolder"
                                        styleClass="ghost"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="playButton"
                                        text="%btn.start"
                                        onAction="#onPlay"
                                        styleClass="primaryBig playBtn"/>
                            </HBox>
                        </VBox>

                        <!-- Overview tabs -->
                        <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="%section.overview" styleClass="sectionTitle"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="%badge.live" styleClass="pillOk"/>
                            </HBox>

                            <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="tabs" VBox.vgrow="ALWAYS">
                                <tabs>
                                    <Tab text="%tab.changelog">
                                        <VBox spacing="10" styleClass="pad16" VBox.vgrow="ALWAYS">
                                            <TextArea fx:id="changelogArea" editable="false" wrapText="true"
                                                      styleClass="logArea" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                    </Tab>

                                    <Tab text="%tab.server">
                                        <VBox spacing="10" styleClass="pad16" VBox.vgrow="ALWAYS">
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="%server.status" styleClass="mutedSmall" minWidth="60"/>
                                                <Label fx:id="serverStatusLabel" text="%server.unknown" styleClass="pillError"/>
                                            </HBox>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="%server.players" styleClass="mutedSmall" minWidth="60"/>
                                                <Label fx:id="serverPlayersLabel" text="-" styleClass="muted"/>
                                            </HBox>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="%server.ping" styleClass="mutedSmall" minWidth="60"/>
                                                <Label fx:id="serverPingLabel" text="-" styleClass="muted"/>
                                            </HBox>
                                            <Label fx:id="serverDetailsLabel"
                                                   text="%server.noCheckYet"
                                                   wrapText="true"
                                                   styleClass="muted"/>
                                        </VBox>
                                    </Tab>

                                    <Tab text="%tab.modpack">
                                        <VBox spacing="10" styleClass="pad16" VBox.vgrow="ALWAYS">
                                            <TextArea fx:id="packInfoArea" editable="false" wrapText="true"
                                                      styleClass="logArea" VBox.vgrow="ALWAYS"/>
                                        </VBox>
                                    </Tab>
                                </tabs>
                            </TabPane>
                        </VBox>

                    </VBox>
                </HBox>

                <!-- BOTTOM AREA: LOG -->
                <VBox styleClass="contentRoot">
                    <TitledPane fx:id="logPane" text="%log.details" expanded="false" styleClass="titledCard">
                        <content>
                            <VBox styleClass="card" spacing="10">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="%btn.copy" onAction="#onCopyLog" styleClass="ghost"/>
                                    <Button text="%btn.clear" onAction="#onClearLog" styleClass="ghostDanger"/>
                                </HBox>

                                <TextArea fx:id="logArea"
                                          editable="false"
                                          wrapText="false"
                                          styleClass="logArea"
                                          VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </content>
                    </TitledPane>
                </VBox>

            </items>
        </SplitPane>
    </center>

</BorderPane>
